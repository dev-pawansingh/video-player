<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="6dp"
    android:background="?attr/selectableItemBackground"
    android:padding="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="0.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Folder Icon with Background -->
            <LinearLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/folder_icon_bg"
                android:gravity="center"
                android:layout_gravity="center_vertical">

                <ImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/folder_icon"
                    app:tint="@color/white" />

            </LinearLayout>

            <!-- Text Content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <!-- Folder Name -->
                <TextView
                    android:id="@+id/foldername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Folder Name"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Folder Path -->
                <TextView
                    android:id="@+id/folderpath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Folder Path"
                    android:textColor="@color/gray_600"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:layout_marginTop="2dp" />

                <!-- Video Count and Last Modified -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/noOfFiles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 Videos"
                        android:textColor="@color/blue_500"
                        android:textSize="13sp"
                        android:background="@drawable/pill_bg"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp" />

                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/gray_400"
                android:layout_gravity="center_vertical" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>